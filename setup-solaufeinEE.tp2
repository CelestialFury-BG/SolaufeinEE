/*************************************************************************
 * Solaufein Romance Mod Pack (Modern EE/EET Edition)
 *
 * Original: Weimer
 * Modernized & Verified for EE/EET compatibility
 *
 * ---------------------------------------------------------------------
 * Version history
 * ---------------------------------------------------------------------
 * v2.1.0  Modern EE/EET Edition (initial modernization).
 * v2.1.1  Bug-fix pass.
 * v2.1.2  Multi-language and dependency pass.
 * v2.1.3  Refactored Component 10's Sola tier COPY block to use
 *         EE_SET_CRE_FIELDS. Fixed effects-offset overwrite.
 * v2.1.4  Full 12-slot Solaufein bark set written to both the Sola
 *         tier and the udsola01/02 block.
 * v2.1.5  Bark playback fix. SAY + [blank] in TRA.
 * v2.1.6  Component dependency fix for CHAIN3 / SOLA.DLG abort.
 * v2.1.7  Core NPC completeness pass.
 * v2.1.8  Content-aligned component layout. Renumbered 10/20/30/40/50.
 * v2.1.9  Fixed top-level PRINT parse error.
 * v2.1.10 Support CRE field fix. Added script_name and dialogue_resref
 *         writes to solaboo, solafoe, solavamp, solaspi, solaspy1,
 *         solaspy2.
 *
 * v2.1.11 Known-spells compaction. The 2010-era mod tree CREs sola5
 *         through sola17, and solafoe.cre, ship with a blank entry
 *         at known-spells index 0 (empty resref, non-zero level and
 *         type). Near Infinity renders it as "Spell: 0.SPL" with a
 *         level and a type. The engine ignores such entries, but
 *         they inflate the count and shift every subsequent entry's
 *         index. Adding LPF EE_COMPACT_KNOWN_SPELLS to the four
 *         affected COPY blocks removes the phantom entry and
 *         decrements the count.
 *
 *         This was never caused by any TP2 change. The earlier
 *         Dialogue/Script fixes (v2.1.3, v2.1.10) only touched
 *         those specific fields, and the current TP2 never passes
 *         ks1..ks8 to EE_SET_CRE_FIELDS, so the known-spells block
 *         in that function never runs. The blank entry has been in
 *         the shipped CRE files since the original 2010 release.
 *************************************************************************/

BACKUP ~solaufeinEE/backup~
AUTHOR ~weimer@cs.berkeley.edu~
VERSION ~v2.1.11~

HANDLE_CHARSETS

ALLOW_MISSING ~bsarev25.dlg~
              ~fatesp.dlg~
              ~valenj.dlg~
              ~bkeldo25.dlg~
              ~ar2500.bcs~
              ~ar2100.bcs~
              ~ar6200.bcs~
              ~cleanse.bcs~

