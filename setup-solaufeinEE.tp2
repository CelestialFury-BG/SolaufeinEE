         ~italian~
         ~solaufeinEE/tra/american/wsetup.tra~
         ~solaufeinEE/tra/italian/wsetup.tra~

LANGUAGE ~Deutsche Sprache (Ubersetzung durch Falk Swoboda)~
         ~german~
         ~solaufeinEE/tra/american/wsetup.tra~
         ~solaufeinEE/tra/german/wsetup.tra~

LANGUAGE ~Francais (traduction de Ly Meng, Laurent Duvernet, Cocobard et Banshee)~
         ~french~
         ~solaufeinEE/tra/american/wsetup.tra~
         ~solaufeinEE/tra/french/wsetup.tra~

LANGUAGE ~Portuguese (traduzido por Allyonora)~
         ~portuguese~
         ~solaufeinEE/tra/american/wsetup.tra~
         ~solaufeinEE/tra/portuguese/wsetup.tra~

LANGUAGE ~Polski jezyk (tlumaczone przez Damiana Staniszewskiego)~
         ~polish~
         ~solaufeinEE/tra/american/wsetup.tra~
         ~solaufeinEE/tra/polish/wsetup.tra~

LANGUAGE ~Russky (Serdrick & aerie.ru)~
         ~russian~
         ~solaufeinEE/tra/american/wsetup.tra~
         ~solaufeinEE/tra/russian/wsetup.tra~

LANGUAGE ~Castellano (traducido por Clan REO)~
         ~spanish~
         ~solaufeinEE/tra/american/wsetup.tra~
         ~solaufeinEE/tra/spanish/wsetup.tra~


///////////////////////////////////////////////////////////////////////
// Component 10: Solaufein - Core NPC + SoA Content (Required)
///////////////////////////////////////////////////////////////////////

BEGIN @1000
DESIGNATED 10

REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @1070

PRINT ~
======================================================================
 Solaufein Romance Mod Pack
======================================================================

 Recommended: answer [I]nstall them at the top-level prompt to install
 every component. This matches the original mod's full experience
 and is the configuration the mod was tested against.

 Expert: answer [A]sk about each one to select components
 individually. Each component's name tells you what it contains
 and whether it is required, optional, or SoA/ToB-specific.

 Components:

   10  Core NPC + SoA Content            (required)
   20  Vampiric Solaufein + Cleanse      (optional, SoA Chapter 6)
   30  ToB Continuation                  (optional, ToB)
   40  Eclipse Sequence                  (optional, ToB)
   50  Extras                            (optional, any)

 Components 20, 30, 40, and 50 each declare a REQUIRE_COMPONENT or
 REQUIRE_PREDICATE that refuses to install on an incompatible game
 state, so no combination you can select will produce a broken
 install.
======================================================================
~

INCLUDE ~solaufeinEE/lib/ee_cre_cleanup.tpa~
INCLUDE ~solaufeinEE/lib/ee_cre_fields.tpa~
INCLUDE ~solaufeinEE/lib/ee_spell_cleanup.tpa~
INCLUDE ~solaufeinEE/lib/ee_cutscene_cleanup.tpa~

APPEND ~action.ids~ ~311 MyCustomAction(O:Object*)~ UNLESS ~MyCustomAction~
APPEND ~trigger.ids~ ~0x40D6 MyCustomTrigger(O:Object*)~ UNLESS ~MyCustomTrigger~

COPY ~solaufeinEE/sounds/blank.wav~ ~override/blank.wav~

///////////////////////////////////////////////////////////////////////
// Sola tier CREs.
///////////////////////////////////////////////////////////////////////

WITH_TRA ~solaufeinEE/tra/%LANGUAGE%/wsetup.tra~ BEGIN
  COPY ~solaufeinEE/creatures/sola5.cre~  ~override/sola5.cre~
       ~solaufeinEE/creatures/sola7.cre~  ~override/sola7.cre~
       ~solaufeinEE/creatures/sola10.cre~ ~override/sola10.cre~
       ~solaufeinEE/creatures/sola12.cre~ ~override/sola12.cre~
       ~solaufeinEE/creatures/sola15.cre~ ~override/sola15.cre~
       ~solaufeinEE/creatures/sola17.cre~ ~override/sola17.cre~
    SAY NAME1 @1 SAY NAME2 @1 SAY BIO @2
    SAY MORALE                @200
    SAY INITIAL_MEETING       @3
    SAY HAPPY                 @3
    SAY UNHAPPY_ANNOYED       @4
    SAY UNHAPPY_SERIOUS       @5
    SAY UNHAPPY_BREAKING_POINT @6
    SAY LEADER                @3
    SAY BORED                 @5
    SAY BATTLE_CRY1           @8
    SAY SELECT_COMMON1        @201
    SAY CRITICAL_HIT          @8
    SAY CRITICAL_MISS         @200
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN
      LPF EE_CRE_CLEANUP END
      LPF EE_SET_CRE_FIELDS
        STR_VAR script_name     = sola
                dialogue_resref = sola
      END
      LPF EE_COMPACT_KNOWN_SPELLS END
    END
END

WITH_TRA ~solaufeinEE/tra/%LANGUAGE%/solavamp.tra~ BEGIN
  COPY ~solaufeinEE/creatures/solavamp.cre~ ~override/solavamp.cre~
    SAY NAME1 @92 SAY NAME2 @92
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN
      LPF EE_CRE_CLEANUP END
      LPF EE_SET_CRE_FIELDS
        STR_VAR script_name     = solavamp
                dialogue_resref = solavamp
      END
      LPF EE_COMPACT_KNOWN_SPELLS END
    END
END

WITH_TRA ~solaufeinEE/tra/%LANGUAGE%/wsetup.tra~ BEGIN
  COPY ~solaufeinEE/creatures/solaspi.cre~ ~override/solaspi.cre~
    SAY NAME1 @9 SAY NAME2 @9
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN
      LPF EE_CRE_CLEANUP END
      LPF EE_SET_CRE_FIELDS
        STR_VAR script_name = solaspi
      END
      LPF EE_COMPACT_KNOWN_SPELLS END
    END
END

WITH_TRA ~solaufeinEE/tra/%LANGUAGE%/wsetup.tra~ BEGIN
  COPY ~solaufeinEE/creatures/solaboo.cre~ ~override/solaboo.cre~
    SAY NAME1 @22 SAY NAME2 @22
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN
      LPF EE_CRE_CLEANUP END
      LPF EE_SET_CRE_FIELDS
        STR_VAR script_name     = solaboo
                dialogue_resref = solaboo
      END
      LPF EE_COMPACT_KNOWN_SPELLS END
    END
END

WITH_TRA ~solaufeinEE/tra/%LANGUAGE%/wsetup.tra~ BEGIN
  COPY ~solaufeinEE/creatures/solafoe.cre~ ~override/solafoe.cre~
    SAY NAME1 @10 SAY NAME2 @10
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN
      LPF EE_CRE_CLEANUP END
      LPF EE_SET_CRE_FIELDS
        STR_VAR script_name     = solafoe
                dialogue_resref = solafoe
      END
      LPF EE_COMPACT_KNOWN_SPELLS END
    END
END

WITH_TRA ~solaufeinEE/tra/%LANGUAGE%/wsetup.tra~ BEGIN
  COPY ~solaufeinEE/creatures/udsola01.cre~ ~override/udsola01.cre~
       ~solaufeinEE/creatures/udsola02.cre~ ~override/udsola02.cre~
    SAY NAME1 @1 SAY NAME2 @1
    SAY MORALE                @200
    SAY INITIAL_MEETING       @3
    SAY HAPPY                 @3
    SAY UNHAPPY_ANNOYED       @4
    SAY UNHAPPY_SERIOUS       @5
    SAY UNHAPPY_BREAKING_POINT @6
    SAY LEADER                @3
    SAY BORED                 @5
    SAY BATTLE_CRY1           @8
    SAY SELECT_COMMON1        @201
    SAY CRITICAL_HIT          @8
    SAY CRITICAL_MISS         @200
    READ_ASCII 0x04 cre_ver (4)
    PATCH_IF (~%cre_ver%~ STRING_EQUAL ~V1.0~) BEGIN
      LPF EE_CRE_CLEANUP END
      LPF EE_SET_CRE_FIELDS
        STR_VAR script_name     = sola
                dialogue_resref = sola
      END
      LPF EE_COMPACT_KNOWN_SPELLS END
    END
END

///////////////////////////////////////////////////////////////////////
// Spell files.
///////////////////////////////////////////////////////////////////////

WITH_TRA ~solaufeinEE/tra/%LANGUAGE%/wsetup.tra~ BEGIN
  COPY ~solaufeinEE/spells/solaspl.spl~  ~override/solaspl.spl~
    SAY NAME1 @11 SAY UNIDENTIFIED_DESC @11
  COPY ~solaufeinEE/spells/spcl999.spl~  ~override/spcl999.spl~
    SAY NAME1 @12 SAY UNIDENTIFIED_DESC @12
  COPY ~solaufeinEE/spells/dimdoor.spl~  ~override/dimdoor.spl~
    SAY NAME1 @13 SAY UNIDENTIFIED_DESC @13
  COPY ~solaufeinEE/spells/boo2cap.spl~  ~override/boo2cap.spl~
    SAY NAME1 @23 SAY UNIDENTIFIED_DESC @23
  COPY ~solaufeinEE/spells/boo2free.spl~ ~override/boo2free.spl~
    SAY NAME1 @24 SAY UNIDENTIFIED_DESC @24
END

COPY ~solaufeinEE/spells/solarepu.spl~ ~override/solarepu.spl~
  SAY NAME1 ~Repulse Undead~
  SAY UNIDENTIFIED_DESC ~Eilistraee's gift to Solaufein, granted after his restoration from vampirism. This ability allows him to channel lunar radiance to turn undead creatures, causing them to flee in terror or be destroyed outright. Solaufein may use this ability three times per day.~
  LPF EE_SPELL_CLEANUP END

