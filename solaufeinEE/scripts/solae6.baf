          HasImmunityEffects(LastSeenBy(Myself))
	  CheckStatGT(LastSeenBy(Myself),0,STONESKINS)
THEN
    RESPONSE #100
	IncrementGlobal("Five","LOCALS",-1)
        SetGlobalTimer("Cast","LOCALS",6)
	SpellNoDec(LastSeenBy(Myself),WIZARD_BREACH)
