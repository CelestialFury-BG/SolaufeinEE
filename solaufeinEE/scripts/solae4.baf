// Spell: Heal (if nearby ally)
/////////////////////////////////////////////////////////////////////
IF
        See(ThirdNearest([ALLY]))
        HPPercentLT(LastSeenBy(Myself),75)
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("SolaE4Heal","GLOBAL",0)
THEN
	RESPONSE #100
