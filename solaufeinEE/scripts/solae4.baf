/////////////////////////////////////////////////////////////////////
// Reffus, 25th level Eclipse Cleric
// 
// We completely ignore in-game memorization (hey, who doesn't?) and
// use global variables to keep track of spells. 
// 
// Memorized Spells By Level: 9 9 9 9 9 7 3 
// Memorized Spells (number, name, casting time): 
//
//      1 SPPR727       fallen deva             5
//      1 SPPR701       shield of archons       9 (prep)
//      1 SPPR728       implosion               5
//      1               physical mirror (prep)
//      5 sPPR607       heal                    9
//      1               blade barrier (prep)    
//      4 sppr503       flame strike            8
//      4               true seeing 
//      9 sppr405       mental domination       4
//      9 sppr304       glyph of warding        9
//      9 sppr208       hold person             5
//      8 sppr109       sanctuary               4
//      1               armor of faith ...
/////////////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////////////
// Battle Prep!
/////////////////////////////////////////////////////////////////////
IF
	Global("Prep","LOCALS",0)
THEN
	RESPONSE #100
          SetGlobalTimer("Cast","LOCALS",0)
          SetGlobalTimer("CastTrue","LOCALS",60)
          GiveItemCreate("potn34",Myself,1,0,0)
          UseItem("potn34",Myself)

          SetGlobal("Deva","LOCALS",1)
          SetGlobal("Shield","LOCALS",1)
          SetGlobal("Implosion","LOCALS",1)
          SetGlobal("SolaE4Heal","GLOBAL",5)
          SetGlobal("Flame","LOCALS",5)
          SetGlobal("True","LOCALS",4)
          SetGlobal("Mental","LOCALS",9)
          SetGlobal("Glyph","LOCALS",9)
          SetGlobal("Hold","LOCALS",9)
          SetGlobal("Sanct","LOCALS",8)

          SetGlobal("Prep","LOCALS",1)
          ReallyForceSpell(Myself,CLERIC_TRUE_SIGHT)
END

/////////////////////////////////////////////////////////////////////
// Spell: Sanctuary (if nearby enemy)
/////////////////////////////////////////////////////////////////////
IF
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("Sanct","LOCALS",0)
	Range(NearestEnemyOf(Myself),3)
	CheckStatLT(Myself,1,SANCTUARY)
THEN
	RESPONSE #100
          IncrementGlobal("Sanct","LOCALS",-1)
          SetGlobalTimer("Cast","LOCALS",6)
	  SpellNoDec(Myself,CLERIC_SANCTUARY)
END

/////////////////////////////////////////////////////////////////////
// Spell: Heal (if nearby ally)
/////////////////////////////////////////////////////////////////////
IF
        See(Nearest([ALLY]))
        HPPercentLT(LastSeenBy(Myself),75)
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("SolaE4Heal","GLOBAL",0)
THEN
	RESPONSE #100
          IncrementGlobal("SolaE4Heal","GLOBAL",-1)
          SetGlobalTimer("Cast","LOCALS",6)
	  SpellNoDec(LastSeenBy(Myself),CLERIC_HEAL)
END

/////////////////////////////////////////////////////////////////////
// Spell: Heal (if nearby ally)
/////////////////////////////////////////////////////////////////////
IF
        See(SecondNearest([ALLY]))
        HPPercentLT(LastSeenBy(Myself),75)
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("SolaE4Heal","GLOBAL",0)
THEN
	RESPONSE #100
          IncrementGlobal("SolaE4Heal","GLOBAL",-1)
          SetGlobalTimer("Cast","LOCALS",6)
	  SpellNoDec(LastSeenBy(Myself),CLERIC_HEAL)
END

