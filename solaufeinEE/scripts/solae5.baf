/////////////////////////////////////////////////////////////////////
// Ylekilnu, 21th level Eclipse Druid
// 
// We completely ignore in-game memorization (hey, who doesn't?) and
// use global variables to keep track of spells. 
// 
// Memorized Spells By Level: 9 9 9 9 8 6 6 
// Memorized Spells (number, name, casting time): 
//
//      1 SPPR701       shield of archons       9 (prep)
//      1 nature's beauty
//      4 1717 CLERIC_CREEPING_DOOM
//      6 1605 CLERIC_CONJURE_FIRE_ELEMENTAL
//      4 1517 CLERIC_INSECT_PLAGUE
//      4 1506 CLERIC_IRONSKIN
//      9 sppr405       mental domination       4
//      9 1319 CLERIC_SUMMON_INSECTS
//      9 sppr208       hold person             5
//      9 1113 CLERIC_DOOM
/////////////////////////////////////////////////////////////////////

/////////////////////////////////////////////////////////////////////
// Battle Prep!
/////////////////////////////////////////////////////////////////////
IF
	Global("Prep","LOCALS",0)
THEN
	RESPONSE #100
          SetGlobalTimer("Cast","LOCALS",0)
          SetGlobalTimer("CastTrue","LOCALS",0)
          GiveItemCreate("potn34",Myself,1,0,0)
          UseItem("potn34",Myself)

          SetGlobal("Beauty","LOCALS",1)
          SetGlobal("Creep","LOCALS",4)
          SetGlobal("Fire","LOCALS",6)
          SetGlobal("InsectP","LOCALS",4) 
          SetGlobal("Iron","LOCALS",4) 
          SetGlobal("Mental","LOCALS",9)
          SetGlobal("InsectS","LOCALS",9)
          SetGlobal("Hold","LOCALS",9)
          SetGlobal("Doom","LOCALS",9)

          SetGlobal("Prep","LOCALS",1)
END

/////////////////////////////////////////////////////////////////////
// Spell: Ironskin
/////////////////////////////////////////////////////////////////////
IF
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("Iron","LOCALS",0)
	CheckStatLT(Myself,1,STONESKINS)
THEN
	RESPONSE #100
	  IncrementGlobal("Iron","LOCALS",-1)
          SetGlobalTimer("Cast","LOCALS",6)
	 SpellNoDec(Myself,CLERIC_IRONSKIN)
END

/////////////////////////////////////////////////////////////////////
// Spell: Beauty 
/////////////////////////////////////////////////////////////////////
IF
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("Beauty","LOCALS",0)
	See(NearestEnemyOfType([PC]))
	Range(NearestEnemyOfType([PC]),20)
THEN
	RESPONSE #100
	  IncrementGlobal("Beauty","LOCALS",-1)
          SetGlobalTimer("Cast","LOCALS",6)
	 SpellNoDec(Myself,CLERIC_NATURE_BEAUTY)
END

/////////////////////////////////////////////////////////////////////
// Spell: Creeping Doom
/////////////////////////////////////////////////////////////////////
IF
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("Creep","LOCALS",0)
	See(NearestEnemyOfType([PC]))
THEN
	RESPONSE #100
	  IncrementGlobal("Creep","LOCALS",-1)
          SetGlobalTimer("Cast","LOCALS",6)
	 SpellNoDec(LastSeenBy(Myself),CLERIC_CREEPING_DOOM)
END

/////////////////////////////////////////////////////////////////////
// Spell: Insect Plauge 
/////////////////////////////////////////////////////////////////////
IF
	GlobalTimerExpired("Cast","LOCALS")
	GlobalGT("InsectP","LOCALS",0)
	See(NearestEnemyOfType([PC]))
THEN
	RESPONSE #100
	  IncrementGlobal("InsectP","LOCALS",-1)
          SetGlobalTimer("Cast","LOCALS",6)
	 SpellNoDec(LastSeenBy(Myself),CLERIC_INSECT_PLAGUE)
END

/////////////////////////////////////////////////////////////////////
// Heal!
/////////////////////////////////////////////////////////////////////
IF
	GlobalTimerExpired("Cast","LOCALS")
        HPPercentLT(Myself,80)
THEN    
        RESPONSE #100
          UseItem("potn55",Myself)
          SetGlobalTimer("Cast","LOCALS",6)
END

