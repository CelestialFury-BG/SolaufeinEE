///////////////////////////////////////////////////////////////////////
// for people doing upgades from a pre-banter Sola
///////////////////////////////////////////////////////////////////////
IF 
  Global("SolaEverSetBanter","GLOBAL",0)
THEN 
  RESPONSE #100
    RealSetGlobalTimer("SolaBanter","GLOBAL",6400)
    SetGlobal("SolaEverSetBanter","GLOBAL",1)
END

///////////////////////////////////////////////////////////////////////
// The Unholy Eclipse
///////////////////////////////////////////////////////////////////////
IF
  Global("SolaEclipseWarn","GLOBAL",0)
  OR(2)
      Dead("Sendai") // Sendai
      Dead("Abazigal") // Abazigal
  OR(2)
    TimeOfDay(0)  // DAY
    TimeOfDay(3)  // MORNING
  CombatCounter(0)
  See(Player1)
  InParty(Myself)
THEN
  RESPONSE #100
    StartCutSceneMode()
    SetGlobal("SolaEclipseWarn","GLOBAL",1)
    StartDialogueNoSet(Player1) // sets warn to 2
    EndCutSceneMode()
END

IF
  Global("SolaEclipseWarn","GLOBAL",2)
  TimeOfDay(2)  // night
  OR(2)
    AreaType(OUTDOOR)
    AreaType(FOREST)
  CombatCounter(0)
  InParty(Myself)
  See(Player1)
THEN
  RESPONSE #100
      IncrementGlobal("SolaEclipseWarn","GLOBAL",1)
      CreateCreatureObject("SolaSpy1",Myself,0,0,0) // No such index
END

///////////////////////////////////////////////////////////////////////
// The New Sword 
///////////////////////////////////////////////////////////////////////
IF
  HasItem("solablad",Myself)
  XPGT(Myself,3500000)
  CombatCounter(0)
  !Detect([ENEMY])
THEN
  RESPONSE #100
    StartCutSceneMode()
        Wait(1)
        ReallyForceSpell(Myself,HOLY_LIGHT_FROM_ABOVE)
        Wait(1)
        DestroyItem("solablad")
        CreateVisualEffectObject("spcrtwpn",Myself)
        GiveItemCreate("SolaBla2",Myself,1,0,0)
        Wait(4)
        SetGlobal("SolaBladeUpgrade","GLOBAL",1)
        StartDialogueNoSet(Player1)
    EndCutSceneMode()
END
