// Traducido y repasado por equip de trad del Almas Torturadas, Clan REO, SirLancelot

// solafoe  translation file

@1 = ~Ah, son los insignificantes habitantes de la superficie que cuidan de Solaufein. Soy Archryssa, una elegida de Lolth.~
@2 = ~He venido por Solaufein, Lolth se dará un festín con sus huesos. Entregádmelo y quizá os permita vivir.~
@3 = ~¡Creo que no, drow! Juntos hemos derrotado a enemigos mucho más poderosos que tú.~
@4 = ~Solaufein y yo somos uno, Archryssa. ¡Si le quieres tendrás que pasar por encima de mi cadáver!~
@5 = ~Solaufein no es una presa fácil. ¡Aunque luche solo no serás rival para él!~
@6 = ~Ah, pero no lucharéis juntos contra mí, habitante de la superficie.~
@7 = ~Lolth me ha dado el poder de separarte de tus compañeros, Solaufein. Su venganza es demasiado personal. Ellos nos observarán desde el Vacío mientras te enfrentas a mí... y a tus peores pesadillas... ¡tú solo!~
@8 = ~Oh, y Viconia... no nos hemos olvidado de ti. Ya te llegará tu hora.~
@9 = ~Y ahora empecemos con la parte divertida... ¡tu muerte!~
@10 = ~Creo que no, varón. ¡A través de mí, Lolth dejará tu alma seca! Y cuando hayas caído, se dará un festín con tus compañeros.~
@11 = ~Puede que seáis uno, pero os separaré para este combate.~
@12 = ~Veremos. Con el favor de la Reina Araña mi poder va más allá de vuestra imaginación.~
@13 = ~Y si escapas... ¡ella los devorará al instante! ¡Enfréntate a mi, Solaufein! ¡Enfréntate a tu muerte!~
@14 = ~Me deleitaré con tu tranformación en draña, Solaufein. Serás atrapado en una criatura regida por su instinto primitivo.~
@175 = ~¡No! ¡Maldita seas!~

@200 = ~¡Estúpido! ¡Nuestra madre Lolth te juzgará por tus palabras! Pero primero caerá el traidor, Solaufein. Mientras él flaquee, decaiga y muera, tú y tu compañía haréis lo mismo.~ ~¡Estúpida! ¡Nuestra madre Lolth te juzgará por tus palabras! Pero primero caerá el traidor, Solaufein. Mientras él flaquee, decaiga y muera, tú y tu compañía haréis lo mismo.~