@19 = ~Twisted Rune Amelioree (recommande, optionnel)~
@20 = ~Spectateurs plus intelligents (ecrit par Xyx, recommande, optionnel)~
@21 = ~Vampires plus intelligents (ecrit par Kensai Ryu, recommande, optionnel)~
@22 = ~Bouh Deux~
@23 = ~Rejoins le groupe~
@24 = ~Relâche Bouh Deux~
@25 = ~Mages plus intelligents (optionnel, quelques bugs reportes)~
@26 = ~Rencontres Tactiques Supplementaires (optionel, plusieurs auteurs)~

@30 = ~Redael, Kensai de l'Eclipse~
@31 = ~Nrodlek, Anti-Paladin de l'Eclipse~
