@1010 = ~Solaufein : Solaufein vampire + Purification (branche scénaristique SoA facultative)~
@1020 = ~Solaufein : Suite ToB (recommandé si vous jouez à ToB)~
@1030 = ~Solaufein : Séquence Éclipse (combat défi ToB facultatif)~
@1040 = ~Solaufein : Extras (correctifs Korgan/Viconia, multijoueur, correctifs de projectiles — facultatif)~
@1070 = ~Ce mod nécessite Baldur's Gate II : Enhanced Edition (BG2EE) ou Enhanced Edition Trilogy (EET).~
@1071 = ~Ce composant nécessite l'extension Throne of Bhaal.~
